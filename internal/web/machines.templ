package web

templ Machines() {
	@Layout("기기", "machines") {
		<header class="page-head">
			<div>
				<h1>기기</h1>
				<p class="page-desc">SSH로 접속해 실제 작업(파일·셸)이 실행되는 원격 PC를 등록합니다.</p>
			</div>
			<button class="btn" type="button">기기 등록</button>
		</header>
		<section class="panel">
			<div class="panel-head">
				<h2>등록된 기기</h2>
			</div>
			<table class="table">
				<thead>
					<tr>
						<th>이름</th>
						<th>호스트</th>
						<th>상태</th>
						<th>마지막 확인</th>
					</tr>
				</thead>
				<tbody>
				</tbody>
			</table>
			@EmptyState("등록된 기기가 없습니다", "작업 기기에는 sshd 와 kiwi 가 설치되어 있어야 합니다.")
		</section>
	}
}
